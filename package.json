{
  "name": "faculty-vault",
  "version": "1.0.0",
  "private": true,
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-cli.mjs generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "node scripts/prisma-cli.mjs generate",
    "prisma:generate": "node scripts/prisma-cli.mjs generate",
    "prisma:generate:sqlite": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "prisma:generate:postgres": "prisma generate --schema=prisma/schema.prisma",
    "prisma:push": "node scripts/prisma-cli.mjs db push",
    "prisma:push:sqlite": "prisma db push --schema=prisma/schema.sqlite.prisma",
    "prisma:push:postgres": "prisma db push --schema=prisma/schema.prisma",
    "prisma:migrate": "node scripts/prisma-cli.mjs migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:studio": "node scripts/prisma-cli.mjs studio",
    "prisma:studio:sqlite": "prisma studio --schema=prisma/schema.sqlite.prisma",
    "prisma:studio:postgres": "prisma studio --schema=prisma/schema.prisma",
    "db:init:local": "prisma db push --schema=prisma/schema.sqlite.prisma && node scripts/seed.mjs",
    "db:init:dev": "node scripts/prisma-cli.mjs db push && node scripts/seed.mjs",
    "db:init:prod": "node scripts/init-prod.mjs",
    "db:bootstrap:prod": "node scripts/init-prod.mjs --skip-schema",
    "seed": "node scripts/seed.mjs",
    "test": "node --loader ./scripts/test-loader.mjs --test tests/*.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-table": "^8.20.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "googleapis": "^144.0.0",
    "lucide-react": "^0.468.0",
    "next": "^14.2.24",
    "next-auth": "^4.24.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
