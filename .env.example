# ==========================================
# Faculty Vault - Environment Configuration
# ==========================================

# 1. PostgreSQL Database (Neon, Supabase, or Local PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/faculty_vault?schema=public"

# For zero-config local file-based testing without PostgreSQL, you can use:
# DATABASE_URL="file:./dev.db"

# 2. NextAuth / Auth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="faculty-vault-secure-auth-secret-change-in-production-min-32-chars"
AUTH_SECRET="faculty-vault-secure-auth-secret-change-in-production-min-32-chars"

# 3. Google OAuth 2.0 (Google Cloud Console > Credentials)
AUTH_GOOGLE_ID="your-google-oauth-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# 4. Google Drive Integration (Shared Drive or Service Account)
GOOGLE_DRIVE_ROOT_FOLDER_ID="your-google-drive-shared-root-folder-id"
GOOGLE_SERVICE_ACCOUNT_EMAIL="faculty-vault-service@your-project-id.iam.gserviceaccount.com"
# Private key with \n or formatted multiline string
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 5. Google Sheets Integration (Reporting Spreadsheet)
GOOGLE_SHEETS_SPREADSHEET_ID="your-google-sheets-spreadsheet-id"

# 6. Admin User Bootstrapping (Comma-separated admin emails)
# Users signing in with these emails automatically receive the ADMIN role
ADMIN_EMAILS="admin@institute.edu,director@institute.edu"

# 7. File Upload Limits
NEXT_PUBLIC_MAX_FILE_SIZE_MB=25
ALLOWED_FILE_EXTENSIONS="pdf,doc,docx,jpg,jpeg,png"

# 8. Local Mock Fallback Mode
# When GOOGLE_SERVICE_ACCOUNT_EMAIL is not set, Faculty Vault seamlessly runs
# with an in-memory/local mock storage and sheets simulator with transparent indicators
ENABLE_MOCK_STORAGE_FALLBACK="true"
