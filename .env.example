# ==============================================================================
# Faculty Vault - Environment Configuration (OAuth 2.0 & My Drive Integration)
# Central Account: iiimt.facultyvault@gmail.com
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL connection URL (e.g. Neon, Supabase, or Local PostgreSQL):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/faculty_vault?schema=public"

# Zero-config local development with SQLite:
# DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. NextAuth / Application Authentication (Professors & Admins)
# ------------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="faculty-vault-secure-auth-secret-change-in-production-min-32-chars"
AUTH_SECRET="faculty-vault-secure-auth-secret-change-in-production-min-32-chars"

# Admin User Bootstrapping (Comma-separated institute admin emails)
# Users signing in with these emails automatically receive the ADMIN role
ADMIN_EMAILS="admin@institute.edu,director@institute.edu"

# ------------------------------------------------------------------------------
# 3. Google OAuth 2.0 Web Server Flow (Central Storage & Faculty Sign-In)
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# ------------------------------------------------------------------------------
# Central Google OAuth Client Credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Authorized OAuth Redirect URI (Must match Google Cloud Console configuration)
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Optional environment override for Google OAuth Refresh Token.
# When omitted, the refresh token is securely stored and managed in `.google-tokens.json`
# after one-time authorization by iiimt.facultyvault@gmail.com from the Admin Console.
GOOGLE_REFRESH_TOKEN=""

# NextAuth Google Provider aliases (backwards compatible with GOOGLE_CLIENT_ID/SECRET)
AUTH_GOOGLE_ID="your-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-client-secret"

# ------------------------------------------------------------------------------
# 4. Google Drive Storage Architecture (My Drive / Faculty Vault)
# Central Account: iiimt.facultyvault@gmail.com
# ------------------------------------------------------------------------------
# Root Folder ID for "My Drive / Faculty Vault".
# If left empty, Faculty Vault automatically searches for or creates the "Faculty Vault"
# root folder in My Drive and caches its ID in the database and tokens file.
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# ------------------------------------------------------------------------------
# 5. Google Sheets Integration (Reporting Spreadsheet)
# ------------------------------------------------------------------------------
GOOGLE_SHEETS_SPREADSHEET_ID="your-google-sheets-spreadsheet-id"

# ------------------------------------------------------------------------------
# 6. Legacy Service Account Fallback (Deprecated)
# Preserved for backward compatibility. OAuth 2.0 above is preferred.
# ------------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# 7. File Upload Limits & Local Mock Storage Fallback
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MAX_FILE_SIZE_MB=25
ALLOWED_FILE_EXTENSIONS="pdf,doc,docx,jpg,jpeg,png"

# Zero-configuration fallback: When Google Drive OAuth is not yet authorized,
# Faculty Vault seamlessly operates in mock storage mode for offline testing.
ENABLE_MOCK_STORAGE_FALLBACK="true"
