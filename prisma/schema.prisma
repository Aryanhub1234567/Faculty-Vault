datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  FACULTY
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AcademicCategory {
  CONFERENCE
  PATENT
  FDP
  RESEARCH_ARTICLE
  BOOK_CHAPTER
  BOOK
}

enum ConferenceNationality {
  NATIONAL
  INTERNATIONAL
}

enum PatentType {
  DESIGN
  UTILITY
}

enum PatentStatus {
  PUBLISH
  GRANT
}

enum ArticleIndexing {
  SCOPUS
  WOS
  SCI
}

enum BookStatus {
  EDIT
  AUTHORED
}

enum SyncAction {
  CREATE
  UPDATE
  DELETE
}

enum SyncStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

model Institute {
  id              String           @id @default(cuid())
  name            String
  code            String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  facultyProfiles FacultyProfile[]
  driveFolders    DriveFolder[]
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  role           UserRole        @default(FACULTY)
  accountStatus  AccountStatus   @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  accounts       Account[]
  sessions       Session[]
  facultyProfile FacultyProfile?
  recordsCreated Record[]        @relation("RecordCreator")
  auditLogs      AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model FacultyProfile {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  instituteId  String
  institute    Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  facultyId    String
  name         String
  email        String
  department   String?
  designation  String?
  phone        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  records      Record[]
  driveFolders DriveFolder[]

  @@unique([instituteId, facultyId])
  @@index([facultyId])
  @@index([email])
}

model AcademicSession {
  id           String        @id @default(cuid())
  name         String        @unique // e.g. "2024-25"
  isCurrent    Boolean       @default(false)
  isActive     Boolean       @default(true)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  records      Record[]
  driveFolders DriveFolder[]
}

model Record {
  id                     String           @id @default(cuid())
  recordCode             String           @unique // e.g. "REC-1001"
  facultyProfileId       String
  facultyProfile         FacultyProfile   @relation(fields: [facultyProfileId], references: [id], onDelete: Cascade)
  academicSessionId      String
  academicSession        AcademicSession  @relation(fields: [academicSessionId], references: [id])
  category               AcademicCategory
  createdById            String
  createdBy              User             @relation("RecordCreator", fields: [createdById], references: [id])
  recordFolderDriveId    String?
  recordFolderWebViewLink String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  deletedAt              DateTime?

  conferenceDetails      ConferenceDetails?
  patentDetails          PatentDetails?
  fdpDetails             FDPDetails?
  researchArticleDetails ResearchArticleDetails?
  bookChapterDetails     BookChapterDetails?
  bookDetails            BookDetails?
  attachments            Attachment[]
  sheetSyncJobs          SheetSyncJob[]

  @@index([facultyProfileId, academicSessionId])
  @@index([category])
  @@index([deletedAt])
  @@index([recordCode])
}

model ConferenceDetails {
  id          String                @id @default(cuid())
  recordId    String                @unique
  record      Record                @relation(fields: [recordId], references: [id], onDelete: Cascade)
  title       String
  topic       String
  organizer   String
  fromDate    DateTime
  toDate      DateTime
  nationality ConferenceNationality
}

model PatentDetails {
  id          String       @id @default(cuid())
  recordId    String       @unique
  record      Record       @relation(fields: [recordId], references: [id], onDelete: Cascade)
  type        PatentType
  title       String
  dateOfApply DateTime
  dateOfIssue DateTime?
  status      PatentStatus
}

model FDPDetails {
  id        String   @id @default(cuid())
  recordId  String   @unique
  record    Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  topic     String
  organizer String
  fromDate  DateTime
  toDate    DateTime
}

model ResearchArticleDetails {
  id        String          @id @default(cuid())
  recordId  String          @unique
  record    Record          @relation(fields: [recordId], references: [id], onDelete: Cascade)
  title     String
  publisher String
  indexing  ArticleIndexing
}

model BookChapterDetails {
  id       String   @id @default(cuid())
  recordId String   @unique
  record   Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  title    String
  topic    String
  date     DateTime
}

model BookDetails {
  id       String     @id @default(cuid())
  recordId String     @unique
  record   Record     @relation(fields: [recordId], references: [id], onDelete: Cascade)
  status   BookStatus
  topic    String
  title    String
  isbn     String     // String to preserve leading zeros and formatting
  date     DateTime   // Specific date type
}

model Attachment {
  id            String   @id @default(cuid())
  recordId      String
  record        Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  driveFileId   String?
  driveFolderId String?
  fileName      String
  mimeType      String
  fileSize      Int
  webViewLink   String?
  localPath     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([recordId])
}

model DriveFolder {
  id                  String          @id @default(cuid())
  instituteId         String?
  institute           Institute?      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  facultyProfileId    String?
  facultyProfile      FacultyProfile? @relation(fields: [facultyProfileId], references: [id], onDelete: Cascade)
  academicSessionId   String?
  academicSession     AcademicSession? @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  category            String?
  folderType          String          // ROOT, INSTITUTE, FACULTY, SESSION, CATEGORY, SUB_CATEGORY, RECORD
  folderPath          String          @unique // e.g. "ABC Institute/F001_Professor_Name/2026-27/Conference/National"
  parentFolderId      String?
  googleDriveFolderId String
  webViewLink         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([folderPath])
}

model SheetSyncJob {
  id          String           @id @default(cuid())
  recordId    String
  record      Record           @relation(fields: [recordId], references: [id], onDelete: Cascade)
  category    AcademicCategory
  action      SyncAction
  status      SyncStatus       @default(PENDING)
  attempts    Int              @default(0)
  maxAttempts Int              @default(5)
  lastError   String?          @db.Text
  payload     String?          @db.Text
  syncedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
  @@index([recordId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
